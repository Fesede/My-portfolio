datasource db {
  provider = "postgresql" 
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?
  projectLink String?
  createdAt   DateTime @default(now())
}

model Skill {
  id         Int    @id @default(autoincrement())
  name       String
  percentage Int
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}